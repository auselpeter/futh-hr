# If you have a password:
# DATABASE_URL="mysql://root:yourpassword@localhost:3306/futh_hr"

# --- App ---
DEFAULT_PASSWORD=admin123
JWT_SECRET="futh-lafia-hr-secret-key-change-in-production"
