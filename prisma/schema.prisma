generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  username               String                 @unique
  passwordHash           String
  fullName               String
  phone                  String?
  avatarUrl              String?
  role                   String                 @default("STAFF")
  secondaryRoles         String?
  activeRoleOverride     String?
  twoFactorEnabled       Boolean                @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String?
  twoFactorEnforcedAt    DateTime?
  twoFactorLastUsedAt    DateTime?
  staffId                String?                @unique
  designationId          String?
  departmentId           String?
  unitId                 String?
  isActive               Boolean                @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  auditLogs              AuditLog[]             @relation("AuditUser")
  secretaryOfCommittees  Committee[]            @relation("CommitteeSecretary")
  chairOfCommittees      Committee[]            @relation("CommitteeChair")
  committeeMembersAdded  CommitteeMember[]      @relation("CommitteeMemberAddedBy")
  headedDepartment       Department?            @relation("DeptHOD")
  documentsUploaded      Document[]             @relation("DocumentUploader")
  fileComments           FileComment[]
  fileRoutesTo           FileRoute[]            @relation("FileRouteToUser")
  fileRoutesFrom         FileRoute[]            @relation("FileRouteFromUser")
  leavesCurrentHolder    Leave[]                @relation("LeaveCurrentHolder")
  leaveRoutesTo          LeaveRoute[]           @relation("LeaveRouteToUser")
  leaveRoutesFrom        LeaveRoute[]           @relation("LeaveRouteFromUser")
  receivedMail           MailMessage[]          @relation("MailTo")
  sentMail               MailMessage[]          @relation("MailFrom")
  notifications          Notification[]         @relation("NotifUser")
  pvComments             PVComment[]
  passwordResetsResolved PasswordResetRequest[] @relation("PasswordResetResolvedBy")
  passwordResetRequests  PasswordResetRequest[]
  fileTargetUser         RegistryFile[]         @relation("FileTargetUser")
  filesCurrent           RegistryFile[]         @relation("FileCurrentHolder")
  filesCreated           RegistryFile[]         @relation("FileCreator")
  requisitionsClosedBy   Requisition[]          @relation("ReqClosedBy")
  reqTargetUser          Requisition[]          @relation("ReqTargetUser")
  requisitionsAssigned   Requisition[]          @relation("ReqAssignee")
  requisitionsCreated    Requisition[]          @relation("ReqCreator")
  requisitionComments    RequisitionComment[]
  requisitionRoutesTo    RequisitionRoute[]     @relation("RouteToUser")
  requisitionRoutesFrom  RequisitionRoute[]     @relation("RouteFromUser")
  rolePermissions        RolePagePermission[]   @relation("UserRolePerms")
  headedUnit             Unit?                  @relation("UnitHOU")
  unit                   Unit?                  @relation("UserUnit", fields: [unitId], references: [id])
  department             Department?            @relation(fields: [departmentId], references: [id])
  designation            Designation?           @relation("UserDesignation", fields: [designationId], references: [id])
  staff                  Staff?                 @relation("UserStaff", fields: [staffId], references: [id])

  @@index([role])
}

model Page {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  description     String?
  icon            String?
  category        String               @default("Main")
  sortOrder       Int                  @default(100)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions RolePagePermission[] @relation("PageRolePerms")
}

model Role {
  id              String               @id @default(cuid())
  code            String               @unique
  name            String
  description     String?
  rank            Int                  @default(100)
  level           String               @default("staff")
  isSystem        Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions RolePagePermission[] @relation("RolePagePerms")
}

model RolePagePermission {
  id          String   @id @default(cuid())
  roleId      String
  pageId      String
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("UserRolePerms", fields: [createdById], references: [id])
  page        Page     @relation("PageRolePerms", fields: [pageId], references: [id], onDelete: Cascade)
  role        Role     @relation("RolePagePerms", fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageId])
  @@index([roleId])
  @@index([pageId])
}

model Department {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  faculty      String?
  hodUserId    String?           @unique
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  hodUser      User?             @relation("DeptHOD", fields: [hodUserId], references: [id])
  designations Designation[]
  postingsTo   PostingTransfer[]
  projects     Project[]
  files        RegistryFile[]
  requisitions Requisition[]
  staff        Staff[]
  trainings    Training[]
  units        Unit[]
  users        User[]
}

model Unit {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  description  String?
  departmentId String
  houUserId    String?           @unique
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postingsTo   PostingTransfer[]
  projects     Project[]
  staff        Staff[]
  houUser      User?             @relation("UnitHOU", fields: [houUserId], references: [id])
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users        User[]            @relation("UserUnit")

  @@index([departmentId])
}

model Designation {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  description      String?
  rank             Int                @default(100)
  level            String             @default("staff")
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  departmentId     String?
  department       Department?        @relation(fields: [departmentId], references: [id])
  fileRouteTargets FileRoute[]        @relation("FileRouteToDesignation")
  postingsTo       PostingTransfer[]
  fileTargets      RegistryFile[]     @relation("FileTargetDesignation")
  reqTargets       Requisition[]      @relation("ReqTargetDesignation")
  reqRouteTargets  RequisitionRoute[] @relation("RouteToDesignation")
  staff            Staff[]            @relation("StaffDesignation")
  users            User[]             @relation("UserDesignation")
}

model Staff {
  id                   String               @id @default(cuid())
  staffId              String               @unique
  ippisNumber          String?
  surname              String
  firstName            String
  otherNames           String?
  fullName             String
  gender               String?
  dateOfBirth          DateTime?
  maritalStatus        String?
  nationality          String?              @default("Nigerian")
  stateOfOrigin        String?
  lga                  String?
  religion             String?
  ninNumber            String?
  tinNumber            String?
  pensionNumber        String?
  nhfNumber            String?
  nhisNumber           String?
  email                String?
  phone                String?
  altPhone             String?
  position             String?
  rank                 String?
  employmentType       String?              @default("permanent")
  fileNumber           String?
  gradeLevel           String?
  step                 String?
  cadre                String?
  dateHired            DateTime?
  confirmationDate     DateTime?
  retirementDate       DateTime?
  status               String               @default("active")
  avatarUrl            String?
  signatureUrl         String?
  thumbprintUrl        String?
  pictureUrl           String?
  residentialAddress   String?
  permanentAddress     String?
  cityOfResidence      String?
  stateOfResidence     String?
  departmentId         String?
  unitId               String?
  designationId        String?
  userId               String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  academicBackground   AcademicBackground[]
  annualReviews        AnnualReview[]
  appraisals           Appraisal[]
  assessments          Assessment[]
  bankDetails          BankDetail[]
  committeeMemberships CommitteeMember[]
  dependants           Dependant[]
  documents            Document[]
  duties               Duty[]
  leaves               Leave[]
  monthlyAppraisals    MonthlyAppraisal[]
  nextOfKin            NextOfKin[]
  postingsTransfers    PostingTransfer[]
  projectMemberships   ProjectMember[]
  promotions           Promotion[]
  quarterlyReviews     QuarterlyReview[]
  resignations         Resignation[]
  retirements          Retirement[]
  designation          Designation?         @relation("StaffDesignation", fields: [designationId], references: [id])
  unit                 Unit?                @relation(fields: [unitId], references: [id])
  department           Department?          @relation(fields: [departmentId], references: [id])
  terminations         Termination[]
  trainingEnrollments  TrainingEnrollment[]
  user                 User?                @relation("UserStaff")

  @@index([departmentId])
  @@index([status])
  @@index([ninNumber])
  @@index([pensionNumber])
}

model NextOfKin {
  id           String   @id @default(cuid())
  staffId      String
  fullName     String
  relationship String?
  gender       String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  occupation   String?
  employerName String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model BankDetail {
  id            String   @id @default(cuid())
  staffId       String
  bankName      String
  accountName   String
  accountNumber String
  accountType   String?  @default("Savings")
  branch        String?
  sortCode      String?
  bvnNumber     String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model AcademicBackground {
  id                String    @id @default(cuid())
  staffId           String
  institution       String
  qualification     String?
  field             String?
  startDate         DateTime?
  endDate           DateTime?
  grade             String?
  certificateUrl    String?
  certificateNumber String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Dependant {
  id           String    @id @default(cuid())
  staffId      String
  fullName     String
  relationship String?
  dateOfBirth  DateTime?
  gender       String?
  createdAt    DateTime  @default(now())
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Duty {
  id                 String    @id @default(cuid())
  staffId            String
  title              String
  description        String?
  type               String    @default("Primary")
  order              Int       @default(1)
  startDate          DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  durationDays       Int?
  status             String    @default("Assigned")
  evidenceUrl        String?
  evidenceFileName   String?
  evidenceNotes      String?
  evidenceUploadedAt DateTime?
  targetScore        Float     @default(100)
  achievedScore      Float?
  grade              String?
  rating             String?
  scoreNotes         String?
  reviewedById       String?
  reviewedByName     String?
  reviewedAt         DateTime?
  reviewRemarks      String?
  weight             Float     @default(1)
  period             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  staff              Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
  @@index([reviewedById])
  @@index([period])
}

model AnnualReview {
  id                 String    @id @default(cuid())
  staffId            String
  period             String
  overallScore       Float     @default(0)
  assessmentScore    Float     @default(0)
  monthlyScore       Float     @default(0)
  quarterlyScore     Float     @default(0)
  appraisalScore     Float     @default(0)
  dutyScore          Float     @default(0)
  verdict            String?
  status             String    @default("Draft")
  comments           String?
  hodName            String?
  hodSignatureUrl    String?
  hodSignedAt        DateTime?
  daName             String?
  daSignatureUrl     String?
  daSignedAt         DateTime?
  annualReviewDuties Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  staff              Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([period])
}

model MonthlyAppraisal {
  id              String    @id @default(cuid())
  staffId         String
  period          String
  month           Int
  year            Int
  score           Float     @default(0)
  grade           String?
  achievements    String?
  challenges      String?
  recommendations String?
  comments        String?
  status          String    @default("Draft")
  hodRemarks      String?
  houRemarks      String?
  hodName         String?
  hodSignedAt     DateTime?
  houName         String?
  houSignedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, year, month])
  @@index([staffId])
}

model QuarterlyReview {
  id           String   @id @default(cuid())
  staffId      String
  period       String
  quarter      Int
  year         Int
  averageScore Float    @default(0)
  grade        String?
  summary      String?
  comments     String?
  status       String   @default("Draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, year, quarter])
  @@index([staffId])
}

model Assessment {
  id                 String   @id @default(cuid())
  staffId            String
  period             String
  knowledgeScore     Float    @default(0)
  skillsScore        Float    @default(0)
  attitudeScore      Float    @default(0)
  communicationScore Float    @default(0)
  totalScore         Float    @default(0)
  grade              String?
  assessedById       String?
  remarks            String?
  status             String   @default("Draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Appraisal {
  id               String   @id @default(cuid())
  staffId          String
  period           String
  performanceScore Float    @default(0)
  achievementScore Float    @default(0)
  competencyScore  Float    @default(0)
  totalScore       Float    @default(0)
  grade            String?
  appraisedById    String?
  remarks          String?
  status           String   @default("Draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  staff            Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model LeaveType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?
  defaultDays         Int      @default(0)
  isPaid              Boolean  @default(true)
  requiresCertificate Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  leaves              Leave[]
}

model Leave {
  id                 String       @id @default(cuid())
  refNumber          String       @unique
  staffId            String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  daysRequested      Int
  daysApproved       Int?
  reason             String
  address            String?
  phone              String?
  certificateUrl     String?
  currentStage       String       @default("Submitted")
  currentHolderId    String?
  status             String       @default("Pending")
  state              String       @default("open")
  hodId              String?
  hodName            String?
  hodRemarks         String?
  hodSignedAt        DateTime?
  houId              String?
  houName            String?
  houRemarks         String?
  houSignedAt        DateTime?
  registryId         String?
  registryName       String?
  registryRemarks    String?
  registryReceivedAt DateTime?
  dfaId              String?
  dfaName            String?
  dfaRemarks         String?
  dfaSignedAt        DateTime?
  cmdId              String?
  cmdName            String?
  cmdRemarks         String?
  cmdSignedAt        DateTime?
  rejectedById       String?
  rejectedAt         DateTime?
  rejectReason       String?
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  currentHolder      User?        @relation("LeaveCurrentHolder", fields: [currentHolderId], references: [id])
  leaveType          LeaveType    @relation(fields: [leaveTypeId], references: [id])
  staff              Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  routes             LeaveRoute[]

  @@index([staffId])
  @@index([status])
  @@index([currentStage])
  @@index([currentHolderId])
}

model LeaveRoute {
  id                String    @id @default(cuid())
  leaveId           String
  fromUserId        String
  toUserId          String?
  stage             String
  action            String
  remarks           String?
  signerName        String?
  signerDesignation String?
  signatureUrl      String?
  signedAt          DateTime?
  createdAt         DateTime  @default(now())
  toUser            User?     @relation("LeaveRouteToUser", fields: [toUserId], references: [id])
  fromUser          User      @relation("LeaveRouteFromUser", fields: [fromUserId], references: [id])
  leave             Leave     @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId])
  @@index([toUserId])
  @@index([fromUserId])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  type        String   @default("public")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Promotion {
  id               String    @id @default(cuid())
  refNumber        String    @unique
  staffId          String
  currentPosition  String?
  currentRank      String?
  currentSalary    Float?
  newPosition      String?
  newRank          String?
  newSalary        Float?
  newDepartmentId  String?
  newDesignationId String?
  type             String    @default("promotion")
  effectiveDate    DateTime
  reason           String?
  justification    String?
  status           String    @default("Submitted")
  state            String    @default("open")
  hodId            String?
  hodName          String?
  hodSignatureUrl  String?
  hodRemarks       String?
  hodSignedAt      DateTime?
  dfaId            String?
  dfaName          String?
  dfaSignatureUrl  String?
  dfaRemarks       String?
  dfaSignedAt      DateTime?
  cmdId            String?
  cmdName          String?
  cmdSignatureUrl  String?
  cmdRemarks       String?
  cmdSignedAt      DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectReason     String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
}

model Termination {
  id                     String    @id @default(cuid())
  refNumber              String    @unique
  staffId                String
  type                   String    @default("termination")
  reason                 String
  detailedReason         String?
  noticeDate             DateTime?
  effectiveDate          DateTime
  lastWorkingDate        DateTime?
  exitInterviewConducted Boolean   @default(false)
  exitInterviewNotes     String?
  handoverCompleted      Boolean   @default(false)
  assetsReturned         Boolean   @default(false)
  clearanceFormUrl       String?
  finalSalary            Float?
  gratuityAmount         Float?
  pensionBalance         Float?
  leaveEncashment        Float?
  status                 String    @default("Submitted")
  state                  String    @default("open")
  hodId                  String?
  hodName                String?
  hodSignatureUrl        String?
  hodRemarks             String?
  hodSignedAt            DateTime?
  dfaId                  String?
  dfaName                String?
  dfaSignatureUrl        String?
  dfaRemarks             String?
  dfaSignedAt            DateTime?
  cmdId                  String?
  cmdName                String?
  cmdSignatureUrl        String?
  cmdRemarks             String?
  cmdSignedAt            DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectReason           String?
  createdById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  staff                  Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
}

model Resignation {
  id                     String    @id @default(cuid())
  refNumber              String    @unique
  staffId                String
  reason                 String
  detailedReason         String?
  resignationDate        DateTime
  noticeDate             DateTime?
  effectiveDate          DateTime
  lastWorkingDate        DateTime?
  isWithdrawn            Boolean   @default(false)
  withdrawnAt            DateTime?
  withdrawnById          String?
  exitInterviewConducted Boolean   @default(false)
  exitInterviewNotes     String?
  handoverCompleted      Boolean   @default(false)
  assetsReturned         Boolean   @default(false)
  clearanceFormUrl       String?
  finalSalary            Float?
  gratuityAmount         Float?
  pensionBalance         Float?
  leaveEncashment        Float?
  status                 String    @default("Submitted")
  state                  String    @default("open")
  hodId                  String?
  hodName                String?
  hodSignatureUrl        String?
  hodRemarks             String?
  hodSignedAt            DateTime?
  dfaId                  String?
  dfaName                String?
  dfaSignatureUrl        String?
  dfaRemarks             String?
  dfaSignedAt            DateTime?
  cmdId                  String?
  cmdName                String?
  cmdSignatureUrl        String?
  cmdRemarks             String?
  cmdSignedAt            DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectReason           String?
  createdById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  staff                  Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
}

model Retirement {
  id                        String    @id @default(cuid())
  refNumber                 String    @unique
  staffId                   String
  type                      String    @default("compulsory")
  reason                    String?
  detailedReason            String?
  dateOfBirth               DateTime?
  retirementDate            DateTime
  lastWorkingDate           DateTime?
  yearsOfService            Int?
  dateOfFirstAppointment    DateTime?
  currentSalaryAtRetirement Float?
  gradeLevelAtRetirement    String?
  gratuityAmount            Float?
  pensionBalance            Float?
  leaveEncashment           Float?
  pensionAdministrator      String?
  pensionPin                String?
  nhfRefundAmount           Float?
  nhisRefundAmount          Float?
  exitInterviewConducted    Boolean   @default(false)
  exitInterviewNotes        String?
  handoverCompleted         Boolean   @default(false)
  assetsReturned            Boolean   @default(false)
  clearanceFormUrl          String?
  certificateOfService      String?
  status                    String    @default("Submitted")
  state                     String    @default("open")
  hodId                     String?
  hodName                   String?
  hodSignatureUrl           String?
  hodRemarks                String?
  hodSignedAt               DateTime?
  dfaId                     String?
  dfaName                   String?
  dfaSignatureUrl           String?
  dfaRemarks                String?
  dfaSignedAt               DateTime?
  cmdId                     String?
  cmdName                   String?
  cmdSignatureUrl           String?
  cmdRemarks                String?
  cmdSignedAt               DateTime?
  rejectedById              String?
  rejectedAt                DateTime?
  rejectReason              String?
  createdById               String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  staff                     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
}

model Training {
  id                     String               @id @default(cuid())
  code                   String               @unique
  title                  String
  description            String?
  type                   String               @default("workshop")
  category               String?
  provider               String?
  facilitator            String?
  location               String?
  mode                   String               @default("physical")
  startDate              DateTime
  endDate                DateTime
  durationHours          Int?
  cost                   Float?
  fundingSource          String?
  targetDesignationId    String?
  targetDepartmentId     String?
  departmentId           String?
  maxParticipants        Int?
  certificateTemplateUrl String?
  status                 String               @default("Open")
  isActive               Boolean              @default(true)
  createdById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  department             Department?          @relation(fields: [departmentId], references: [id])
  enrollments            TrainingEnrollment[]

  @@index([departmentId])
  @@index([status])
  @@index([startDate])
}

model TrainingEnrollment {
  id             String    @id @default(cuid())
  trainingId     String
  staffId        String
  status         String    @default("Enrolled")
  enrolledAt     DateTime  @default(now())
  attendedAt     DateTime?
  completedAt    DateTime?
  attendanceRate Float?
  score          Float?
  grade          String?
