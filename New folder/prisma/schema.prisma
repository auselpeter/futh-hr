// Prisma schema for FUTH LAFIA HR System
// FEDERAL UNIVERSITY TEACHING HOSPITAL - Human Resources Management & Registry System
//
// === SETUP INSTRUCTIONS ===
//
// LOCAL (SQLite — default):
//   .env:  DATABASE_URL="file:./db/custom.db"
//   Run:   bunx prisma db push && bunx prisma generate
//   Start: bun run dev
//
// CLOUD (MySQL):
//   .env:  DATABASE_URL="mysql://user:pass@host:3306/futh_hr"
//   Change "provider = sqlite" to "provider = mysql" below
//   Run:   bunx prisma db push && bunx prisma generate
//   Import data: mysql -u root -p futh_hr < futh_hr_mysql_dump.sql
//   Start: bun run start
// ===============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For SQLite (local):   provider = "mysql"
  // For MySQL (cloud):    change to provider = "mysql"
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: USERS, ROLES, DEPARTMENTS, DESIGNATIONS, STAFF
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?

  // Role: SUPER_ADMIN, ADMIN, CMD, CMA, AD, HOD, HOU, DFA, APPRAISAL_OFFICER, REGISTRY_OFFICER, STAFF
  role String @default("STAFF")

  // === Role-switching ===
  // Primary role is stored in `role`. Secondary roles (a user may have multiple
  // designations / functions) are stored here as a comma-separated list. The user
  // can switch their active role at runtime to any in this list (or back to `role`).
  secondaryRoles String? // comma-separated list of role codes, e.g. "HOD,APPRAISAL_OFFICER"
  activeRoleOverride String? // if set, the UI uses this as the active role instead of `role`

  // === Two-Factor Authentication (TOTP) ===
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?  // TOTP secret (base32)
  twoFactorRecoveryCodes String?  // JSON array of 8 single-use recovery codes (bcrypt-hashed)
  twoFactorEnforcedAt    DateTime? // when 2FA was enforced (for executive roles)
  twoFactorLastUsedAt    DateTime? // last time a 2FA code was verified

  // Links
  staffId       String? @unique
  staff         Staff?       @relation("UserStaff", fields: [staffId], references: [id])
  designationId String?
  designation   Designation? @relation("UserDesignation", fields: [designationId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  unitId        String?
  unit          Unit?         @relation("UserUnit", fields: [unitId], references: [id])

  // Departments headed
  headedDepartment Department? @relation("DeptHOD")

  // Units headed
  headedUnit Unit? @relation("UnitHOU")

  isActive   Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Mail
  sentMail     MailMessage[] @relation("MailFrom")
  receivedMail MailMessage[] @relation("MailTo")

  // Requisitions
  requisitionsCreated    Requisition[]    @relation("ReqCreator")
  requisitionsAssigned   Requisition[]    @relation("ReqAssignee")
  requisitionsClosedBy   Requisition[]    @relation("ReqClosedBy")
  reqTargetUser          Requisition[]    @relation("ReqTargetUser")
  requisitionRoutesFrom  RequisitionRoute[] @relation("RouteFromUser")
  requisitionRoutesTo    RequisitionRoute[] @relation("RouteToUser")
  requisitionComments    RequisitionComment[]

  // Files
  filesCreated      RegistryFile[]    @relation("FileCreator")
  filesCurrent      RegistryFile[]    @relation("FileCurrentHolder")
  fileTargetUser    RegistryFile[]    @relation("FileTargetUser")
  fileRoutesFrom    FileRoute[]      @relation("FileRouteFromUser")
  fileRoutesTo      FileRoute[]      @relation("FileRouteToUser")
  fileComments      FileComment[]

  // Leaves
  leavesCurrentHolder Leave[]       @relation("LeaveCurrentHolder")
  leaveRoutesFrom     LeaveRoute[]  @relation("LeaveRouteFromUser")
  leaveRoutesTo       LeaveRoute[]  @relation("LeaveRouteToUser")

  // Notifications
  notifications Notification[] @relation("NotifUser")

  // Audit
  auditLogs AuditLog[] @relation("AuditUser")

  // Documents uploaded by this user
  documentsUploaded Document[] @relation("DocumentUploader")

  // Role-page permissions (for this user's role)
  rolePermissions RolePagePermission[] @relation("UserRolePerms")

  // Committee leadership
  chairOfCommittees Committee[] @relation("CommitteeChair")
  secretaryOfCommittees Committee[] @relation("CommitteeSecretary")

  // Committee members added by this user (audit)
  committeeMembersAdded CommitteeMember[] @relation("CommitteeMemberAddedBy")

  // Password resets — requests submitted for this user, and requests resolved by this admin
  passwordResetRequests  PasswordResetRequest[]
  passwordResetsResolved PasswordResetRequest[] @relation("PasswordResetResolvedBy")

  // PV comments
  pvComments PVComment[]

  @@index([role])
  @@map("users")
}

// ============================================================
// PAGES, ROLES, PERMISSIONS — for Users Management module
// ============================================================

// A "Page" represents a navigable module/view in the app.
model Page {
  id          String   @id @default(cuid())
  key         String   @unique // matches ViewKey in Sidebar.tsx (dashboard, requisitions, etc.)
  name        String   // human-readable name (e.g. "Requisitions")
  description String?
  icon        String?  // lucide icon name
  category    String   @default("Main") // Main | Admin | Executive | HR
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Permissions granted to roles for this page
  rolePermissions RolePagePermission[] @relation("PageRolePerms")
  @@map("pages")
}

// A "Role" mirrors the role string on User — but lets admins manage
// which roles exist, their display names, and rank.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // SUPER_ADMIN, ADMIN, CMD, CMA, AD, HOD, HOU, DFA, APPRAISAL_OFFICER, REGISTRY_OFFICER, STAFF
  name        String   // Human-readable name
  description String?
  rank        Int      @default(100) // higher = more senior
  level       String   @default("staff") // executive | directorate | management | officer | staff
  isSystem    Boolean  @default(false) // true for built-in roles — prevents deletion
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Permissions granted to this role (across pages)
  rolePermissions RolePagePermission[] @relation("RolePagePerms")
  @@map("roles")
}

// Junction table: which role can access which page, and with what actions.
model RolePagePermission {
  id        String   @id @default(cuid())
  roleId    String
  pageId    String
  role      Role     @relation("RolePagePerms", fields: [roleId], references: [id], onDelete: Cascade)
  page      Page     @relation("PageRolePerms", fields: [pageId], references: [id], onDelete: Cascade)

  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)

  // Audit
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional back-ref to a user who last modified (audit only)
  updatedBy User? @relation("UserRolePerms", fields: [createdById], references: [id])

  @@unique([roleId, pageId])
  @@index([roleId])
  @@index([pageId])
  @@map("role_page_permissions")
}

model Department {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  faculty   String?
  hodUserId String? @unique
  hodUser   User?   @relation("DeptHOD", fields: [hodUserId], references: [id])
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  staff        Staff[]
  designations Designation[]
  files        RegistryFile[]
  requisitions Requisition[]
  units        Unit[]
  trainings    Training[]
  projects     Project[]
  postingsTo   PostingTransfer[]
  @@map("departments")
}

// Unit — a sub-division of a Department. E.g. ICU Unit under Internal Medicine,
// Library Unit under Academic Affairs, etc.
model Unit {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  houUserId   String?  @unique
  houUser     User?     @relation("UnitHOU", fields: [houUserId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff    Staff[]
  projects Project[]
  postingsTo PostingTransfer[]
  users    User[]   @relation("UserUnit")

  @@index([departmentId])
  @@map("units")
}

// Designations = Roles/positions in the institution hierarchy.
// Default seeded designations: CMD, CMA, AD, HOD, HOU, DFA, APPRAISAL_OFFICER, REGISTRY_OFFICER, STAFF
model Designation {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. CMD, CMA, AD, HOD, HOU, DFA, AO, REG, STF
  name        String  // e.g. "Chief Medical Director"
  description String?
  rank        Int     @default(100) // higher = more senior (CMD=1000, CMA=900, AD=800, HOD=700, HOU=600, DFA=500, AO=400, REG=300, STF=100)
  level       String @default("staff") // executive | directorate | management | officer | staff
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  // Routing targets
  reqTargets       Requisition[]       @relation("ReqTargetDesignation")
  reqRouteTargets RequisitionRoute[]   @relation("RouteToDesignation")
  fileTargets      RegistryFile[]      @relation("FileTargetDesignation")
  fileRouteTargets FileRoute[]         @relation("FileRouteToDesignation")

  // Staff with this designation
  staff          Staff[]               @relation("StaffDesignation")

  // Posting/Transfer target designation
  postingsTo PostingTransfer[]

  // Users with this designation (one-to-many back-rel)
  users          User[]                @relation("UserDesignation")
  @@map("designations")
}

model Staff {
  id            String   @id @default(cuid())
  staffId       String   @unique // FUTH internal staff number e.g. ICT/001
  ippisNumber   String?

  // === Identity ===
  surname       String
  firstName     String
  otherNames    String?
  fullName      String
  gender        String? // Male | Female
  dateOfBirth   DateTime?
  maritalStatus String? // Single | Married | Divorced | Widowed
  nationality   String? @default("Nigerian")
  stateOfOrigin String?
  lga           String?
  religion      String?

  // === Government / Compliance numbers ===
  ninNumber     String?  // National Identification Number
  tinNumber     String?  // Tax Identification Number
  pensionNumber String?  // Pension PIN
  nhfNumber     String?  // National Housing Fund
  nhisNumber    String?  // National Health Insurance Scheme

  // === Contact ===
  email         String?
  phone         String?
  altPhone      String?

  // === Employment ===
  position      String?
  rank          String?
  employmentType String? @default("permanent") // permanent | contract | temp | intern
  fileNumber    String?  // Staff file number — manually set by Registry (not auto-generated)
  gradeLevel    String?  // Grade level (e.g. "5", "8", "12") — from IPPIS nominal roll
  step          String?  // Step within grade level (e.g. "1", "2", "3")
  cadre         String?  // Cadre (e.g. "SNR DATA P. ASST. I") — from IPPIS nominal roll
  dateHired     DateTime?
  confirmationDate DateTime?
  retirementDate DateTime?
  status        String   @default("active") // active | on_leave | suspended | retired | disengaged

  // === Biometrics & uploads ===
  avatarUrl     String?  // passport photo
  signatureUrl String?  // signature image
  thumbprintUrl String? // thumbprint / biometric capture
  pictureUrl    String? // additional photo (profile)

  // === Address ===
  residentialAddress String?
  permanentAddress   String?
  cityOfResidence    String?
  stateOfResidence   String?

  // === Department, Unit & Designation ===
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])

  designationId String?
  designation   Designation? @relation("StaffDesignation", fields: [designationId], references: [id])

  userId        String?  @unique
  user          User?    @relation("UserStaff")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // === Related records ===
  nextOfKin       NextOfKin[]
  bankDetails    BankDetail[]
  academicBackground AcademicBackground[]
  dependants      Dependant[]

  // Appraisal & review records
  duties           Duty[]
  annualReviews     AnnualReview[]
  monthlyAppraisals MonthlyAppraisal[]
  quarterlyReviews QuarterlyReview[]
  assessments       Assessment[]
  appraisals        Appraisal[]
  leaves            Leave[]

  // HR lifecycle
  promotions        Promotion[]
  terminations      Termination[]
  resignations      Resignation[]
  retirements       Retirement[]

  // Posting & Transfer
  postingsTransfers PostingTransfer[]

  // Training & Projects
  trainingEnrollments TrainingEnrollment[]
  projectMemberships   ProjectMember[]

  // Documents linked to this staff record (e.g. personal image/signature, hardcopy scans)
  documents Document[]

  // Committee memberships — proper m2m via CommitteeMember join table
  committeeMemberships CommitteeMember[]

  @@index([departmentId])
  @@index([status])
  @@index([ninNumber])
  @@index([pensionNumber])
  @@map("staff")
}

// ============================================================
// STAFF ENRICHMENT — Next of Kin, Bank, Academic, Dependants
// ============================================================

model NextOfKin {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fullName    String
  relationship String? // Spouse | Child | Parent | Sibling | Other
  gender      String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  occupation  String?
  employerName String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId])
  @@map("next_of_kin")
}

model BankDetail {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  bankName    String
  accountName String
  accountNumber String
  accountType String?  @default("Savings") // Savings | Current | Salary
  branch      String?
  sortCode    String?
  bvnNumber   String?  // Bank Verification Number
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId])
  @@map("bank_details")
}

model AcademicBackground {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  institution String
  qualification String? // SSCE | ND | HND | BSc | MSc | PhD | MBBS | Fellowship | Diploma | Certificate
  field       String?  // Course of study
  startDate   DateTime?
  endDate     DateTime?
  grade       String?  // Class of degree
  certificateUrl String?
  certificateNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId])
  @@map("academic_background")
}

model Dependant {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fullName    String
  relationship String?
  dateOfBirth DateTime?
  gender      String?
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@map("dependants")
}

// ============================================================
// APPRAISAL / REVIEW MODULES
// ============================================================

// Duty — a recurring responsibility assigned to a staff for evaluation
model Duty {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // === Task details ===
  title       String
  description String?
  type        String   @default("Primary")  // Primary | Secondary | Routine | Project-based
  order       Int      @default(1)  // ordering within a staff's duties

  // === Duration & deadline ===
  startDate   DateTime?
  dueDate     DateTime?  // deadline to complete the duty
  completedAt DateTime?
  durationDays Int?  // expected number of days to complete (auto-calc from start to due date)

  // === Status & overdue tracking ===
  // Assigned | In Progress | Completed | Approved | Rejected | Overdue
  status      String   @default("Assigned")

  // === Evidence of completion ===
  // When staff completes a duty, they upload evidence (file/document/photo)
  evidenceUrl      String?
  evidenceFileName String?
  evidenceNotes    String?  // staff notes about the completion
  evidenceUploadedAt DateTime?

  // === Scoring ===
  targetScore  Float   @default(100)
  achievedScore Float?
  grade       String?
  rating      String?  // Outstanding | Excellent | Very Good | Good | Satisfactory | Poor
  scoreNotes  String?  // reviewer's notes on the score

  // === Review workflow ===
  // HOU reviews the duty of their unit's staff
  // HOD reviews the HOU's duties (the HOU is also a staff member)
  reviewedById   String?
  reviewedByName String?
  reviewedAt    DateTime?
  reviewRemarks String?

  weight       Float    @default(1) // weight in aggregate
  period       String? // e.g. "2025" or "2025-Q4"

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId])
  @@index([status])
  @@index([reviewedById])
  @@index([period])
}

// Annual Review — yearly performance summary (dual-signature workflow)
model AnnualReview {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period          String   // e.g. "2025"

  overallScore    Float    @default(0)
  assessmentScore Float    @default(0)
  monthlyScore    Float    @default(0)
  quarterlyScore  Float    @default(0)
  appraisalScore  Float    @default(0)
  dutyScore       Float    @default(0)
  verdict         String?  // Outstanding | Excellent | Very Good | Good | Satisfactory | Poor

  status          String   @default("Draft") // Draft | Submitted | HOD Signed | DA Signed | Completed
  comments        String?

  // HOD signature
  hodName         String?
  hodSignatureUrl String?
  hodSignedAt     DateTime?

  // DA (Departmental Administrator) signature
  daName          String?
  daSignatureUrl  String?
  daSignedAt      DateTime?

  // Duty snapshot at review time
  annualReviewDuties Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
  @@index([period])
}

// Monthly Appraisal — monthly check-in (12 per staff per year)
model MonthlyAppraisal {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period          String   // e.g. "2025-01"
  month           Int      // 1-12
  year            Int

  score           Float    @default(0)
  grade           String?
  achievements    String?
  challenges      String?
  recommendations String?
  comments        String?

  status          String   @default("Draft") // Draft | Submitted | Acknowledged | Signed
  hodRemarks      String?
  houRemarks      String?

  hodName         String?
  hodSignedAt     DateTime?
  houName         String?
  houSignedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, year, month])
  @@index([staffId])
}

// Quarterly Review — Q1-Q4 review with auto-averaging from monthly
model QuarterlyReview {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period          String   // e.g. "2025-Q1"
  quarter         Int      // 1-4
  year            Int

  averageScore    Float    @default(0)
  grade           String?
  summary         String?
  comments        String?
  status          String   @default("Draft") // Draft | Submitted | Completed

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, year, quarter])
  @@index([staffId])
}

// Assessment — knowledge + skills + attitude + communication
model Assessment {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period          String   // e.g. "2025"

  knowledgeScore  Float    @default(0)
  skillsScore     Float    @default(0)
  attitudeScore   Float    @default(0)
  communicationScore Float @default(0)
  totalScore      Float    @default(0)
  grade           String?

  assessedById    String?
  remarks         String?
  status          String   @default("Draft") // Draft | Submitted | Reviewed

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
}

// Appraisal — performance + achievement + competency
model Appraisal {
  id              String   @id @default(cuid())
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period          String   // e.g. "2025"

  performanceScore Float   @default(0)
  achievementScore Float  @default(0)
  competencyScore  Float  @default(0)
  totalScore       Float  @default(0)
  grade            String?

  appraisedById   String?
  remarks         String?
  status          String   @default("Draft")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
}

// ============================================================
// LEAVE MANAGEMENT
// ============================================================

model LeaveType {
  id          String   @id @default(cuid())
  code        String   @unique // annual | study | sick | maternity | paternity | casual | compassionate | examination | sabbatical | without_pay
  name        String
  description String?
  defaultDays Int      @default(0)
  isPaid      Boolean  @default(true)
  requiresCertificate Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  leaves Leave[]
}

model Leave {
  id            String   @id @default(cuid())
  refNumber     String   @unique // e.g. LV-2025-000001
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  daysApproved  Int?
  reason        String
  address       String?
  phone         String?
  certificateUrl String?

  // === Workflow tracking ===
  // Stage: Submitted | HOU Review | HOD Review | Registry | Forwarded | Completed | Rejected | Cancelled
  currentStage  String   @default("Submitted")
  // Who currently has this leave form
  currentHolderId   String?
  currentHolder     User? @relation("LeaveCurrentHolder", fields: [currentHolderId], references: [id])

  status        String   @default("Pending") // Pending | HOU Approved | HOD Approved | Registry Received | Forwarded | Completed | Rejected | Cancelled
  state         String   @default("open")    // open | approved | rejected | cancelled | completed

  // Legacy approval fields (kept for backward compatibility)
  hodId         String?
  hodName       String?
  hodRemarks    String?
  hodSignedAt   DateTime?

  houId         String?
  houName       String?
  houRemarks    String?
  houSignedAt   DateTime?

  registryId       String?
  registryName     String?
  registryRemarks  String?
  registryReceivedAt DateTime?

  dfaId         String?
  dfaName       String?
  dfaRemarks    String?
  dfaSignedAt   DateTime?

  cmdId         String?
  cmdName       String?
  cmdRemarks    String?
  cmdSignedAt   DateTime?

  rejectedById  String?
  rejectedAt    DateTime?
  rejectReason  String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Routing trail — each step of the workflow
  routes       LeaveRoute[]

  @@index([staffId])
  @@index([status])
  @@index([currentStage])
  @@index([currentHolderId])
}

// Leave routing trail — tracks each step: who sent it, who received it, what action was taken
model LeaveRoute {
  id          String   @id @default(cuid())
  leaveId     String
  leave       Leave    @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  // Who sent/acted
  fromUserId  String
  fromUser    User    @relation("LeaveRouteFromUser", fields: [fromUserId], references: [id])

  // Who received it (optional — for "reject" or "complete" actions, there's no recipient)
  toUserId    String?
  toUser      User?   @relation("LeaveRouteToUser", fields: [toUserId], references: [id])

  // The stage at this step
  stage       String   // Submitted | HOU Review | HOD Review | Registry | Forwarded | Completed | Rejected | Returned

  // What action was taken
  action      String   // submit | hou_approve | hod_approve | registry_receive | forward | return_to_registry | complete | reject | cancel

  // Remarks at this step
  remarks     String?

  // Optional signature
  signerName       String?
  signerDesignation String?
  signatureUrl     String?
  signedAt         DateTime?

  createdAt   DateTime @default(now())

  @@index([leaveId])
  @@index([toUserId])
  @@index([fromUserId])
}

// Holiday calendar
model Holiday {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  type        String   @default("public") // public | religious | institutional
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// PROMOTIONS / TERMINATIONS / RESIGNATIONS — HR lifecycle
// ============================================================

model Promotion {
  id            String   @id @default(cuid())
  refNumber     String   @unique // e.g. PRM-2026-000001
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // From / To
  currentPosition String?
  currentRank    String?
  currentSalary  Float?
  newPosition    String?
  newRank        String?
  newSalary      Float?
  newDepartmentId String?
  newDesignationId String?

  // Type: promotion | upgrade | conversion | redesignation
  type          String   @default("promotion")
  effectiveDate DateTime
  reason        String?
  justification String?

  // Status: Draft | Submitted | HOD Approved | DFA Approved | CMD Approved | Rejected | Cancelled | Completed
  status        String   @default("Submitted")
  state         String   @default("open")

  // Approval signatures
  hodId           String?
  hodName         String?
  hodSignatureUrl String?
  hodRemarks      String?
  hodSignedAt     DateTime?

  dfaId           String?
  dfaName         String?
  dfaSignatureUrl String?
  dfaRemarks      String?
  dfaSignedAt     DateTime?

  cmdId           String?
  cmdName         String?
  cmdSignatureUrl String?
  cmdRemarks      String?
  cmdSignedAt     DateTime?

  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId])
  @@index([status])
}

model Termination {
  id             String   @id @default(cuid())
  refNumber      String   @unique // e.g. TRM-2026-000001
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Type: termination | dismissal | retirement | contract-end | death
  type           String  @default("termination")
  reason         String
  detailedReason String?

  // Effective
  noticeDate     DateTime?
  effectiveDate  DateTime
  lastWorkingDate DateTime?

  // Exit interview
  exitInterviewConducted Boolean @default(false)
