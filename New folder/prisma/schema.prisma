// ============================================================
// PROJECTS — institutional projects with members & milestones
// ============================================================

model Project {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String?
  type         String  @default("institutional")
  category     String?
  priority     String  @default("Normal")
  sponsorId        String?
