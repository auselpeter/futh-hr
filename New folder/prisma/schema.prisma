  title       String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  status      String  @default("Pending")
  weight      Int  @default(1)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([projectId])
  @@index([status])
}

// ============================================================
// PAYMENT VOUCHERS (PV) — DFA → Desk Officer → Audit workflow
// ============================================================

model PaymentVoucher {
  id            String   @id @default(cuid())
  refNumber     String   @unique
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  pvType        String   @default("treasury_f1")
  voteNumber       String?
  subHead          String?
  voucherNumber    String?
  classificationCode String?
  departmentalNumber String?
  payeeName       String
  payeeAddress    String?
  payeePhone      String?
  payeeAccountNumber String?
  payeeBankName   String?
  chequeNumber    String?
  amountNaira     Int  @default(0)
  amountKobo     Int  @default(0)
  amountInWords  String?
  lineItems       String?
  payableAt       String?
  paymentStation  String?
  status          String   @default("Draft")
  state           String   @default("open")
  deskOfficerId       String?
  deskOfficerName     String?
  deskOfficerSignatureUrl String?
  deskOfficerRemarks  String?
  raisedAt            DateTime?
  auditOfficerId      String?
  auditOfficerName    String?
  auditComments       String?
  auditSignatureUrl   String?
  auditReviewedAt     DateTime?
  auditApprovedAt     DateTime?
  queryText           String?
  queryRaisedAt       DateTime?
  queryRaisedById     String?
  initiatorResponse   String?
  initiatorRespondedAt DateTime?
  initiatorRespondedById String?
  oceName             String?
  oceSignatureUrl     String?
  oceSignedAt         DateTime?
  oceRemarks          String?
  payingOfficerId     String?
  payingOfficerName   String?
  payingOfficerSignatureUrl String?
  paymentAuthorizedAt DateTime?
  paidAt              DateTime?
  paidBy              String?
  dfaApprovedPV       Boolean @default(false)
  dfaApprovedAt      DateTime?
  dfaRemarks          String?
  cmdApprovedPV       Boolean @default(false)
  cmdApprovedAt      DateTime?
  createdById  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    PVComment[]
  attachments PVAttachment[]
  @@index([requisitionId])
  @@index([status])
  @@index([deskOfficerId])
  @@index([auditOfficerId])
}

model PVComment {
  id          String   @id @default(cuid())
  pvId        String
  pv          PaymentVoucher @relation(fields: [pvId], references: [id], onDelete: Cascade)
  type        String  @default("comment")
  body        String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  @@index([pvId])
}

model PVAttachment {
  id          String   @id @default(cuid())
  pvId        String
  pv          PaymentVoucher @relation(fields: [pvId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedById String?
  createdAt   DateTime @default(now())
  @@index([pvId])
}

// ============================================================
// REPORTS — report templates + generated reports
// ============================================================

model ReportTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String
  accessLevel String   @default("management")
  module      String   @default("staff")
  format      String   @default("both")
  icon        String?
  hasDateRange Boolean @default(true)
  hasDeptFilter Boolean @default(true)
  sortOrder   Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     GeneratedReport[]
}

model GeneratedReport {
  id          String   @id @default(cuid())
  templateId  String
  template    ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  departmentId String?
  filters     String?
  fileName    String
  fileUrl     String?
  data        String?
  generatedById String
  generatedAt   DateTime @default(now())
  @@index([templateId])
  @@index([generatedById])
}

// ============================================================
// POSTING & TRANSFER — staff posting/transfer workflow
// ============================================================

model PostingTransfer {
  id            String   @id @default(cuid())
  refNumber     String   @unique
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type          String   @default("posting")
  fromDepartmentId String?
  fromUnitId       String?
  fromPosition     String?
  fromDesignationId String?
  toDepartmentId String?
  toDepartment   Department? @relation(fields: [toDepartmentId], references: [id])
  toUnitId       String?
  toUnit         Unit?       @relation(fields: [toUnitId], references: [id])
  toPosition     String?
  toDesignationId String?
  toDesignation  Designation? @relation(fields: [toDesignationId], references: [id])
  reason        String
  detailedReason String?
  effectiveDate DateTime
  reportDeadline DateTime?
  handoverDate  DateTime?
  status        String   @default("Submitted")
  state         String   @default("open")
  planningReviewedById String?
  planningReviewedAt   DateTime?
  planningRemarks      String?
  hodId           String?
  hodName         String?
  hodSignatureUrl String?
  hodRemarks      String?
  hodSignedAt     DateTime?
  dfaId           String?
  dfaName         String?
  dfaSignatureUrl String?
  dfaRemarks      String?
  dfaSignedAt     DateTime?
  cmdId           String?
  cmdName         String?
  cmdSignatureUrl String?
  cmdRemarks      String?
  cmdSignedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  postingLetterUrl String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([staffId])
  @@index([status])
  @@index([toDepartmentId])
}

// ============================================================
// REQUISITIONS (service / expense / other)
// ============================================================

model Requisition {
  id           String   @id @default(cuid())
  refNumber    String   @unique // e.g. FUTH/REQ/SVC/2025/0001
  type         String   // service | expense | other
  subject      String
  description  String
  comment      String?

  // Amount (for expense type)
  amount       Float?

  // Priority
  priority     String   @default("Normal") // Low | Normal | High | Urgent | Critical

  // Status workflow:
  // Draft -> Submitted -> In Review -> Approved -> Closed
  //                            \-> Rejected -> Closed
  //                            \-> Returned -> (resubmit)
  status       String   @default("Submitted")
  // Sub-state for terminal actions:
  // open | forwarded | approved | rejected | returned | closed_permanently
  state        String   @default("open")

  // Creator
  createdById   String
  createdBy     User     @relation("ReqCreator", fields: [createdById], references: [id])

  // Current assignee (the user who must act next) - optional if routed to a designation
  assigneeId    String?
  assignee      User?    @relation("ReqAssignee", fields: [assigneeId], references: [id])

  // Routing target — either a specific user (staff) OR a designation
  targetUserId       String?
  targetUser         User?   @relation("ReqTargetUser", fields: [targetUserId], references: [id])
  targetDesignationId String?
  targetDesignation  Designation? @relation("ReqTargetDesignation", fields: [targetDesignationId], references: [id])
  targetDepartmentId String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Closure
  closedAt     DateTime?
  closedById   String?
  closedBy     User?   @relation("ReqClosedBy", fields: [closedById], references: [id])
  closureNote  String?

  // === Multi-signature workflow ===
  // For expense requisitions: CMD + DFA signatures required for final approval
  // For service requisitions: CMD + DA (Departmental Administrator) signatures required
  // For other: route-defined signatures
  cmdId           String?
  cmdName         String?
  cmdSignatureUrl String?
  cmdRemarks      String?
  cmdSignedAt     DateTime?

  dfaId           String?
  dfaName         String?
  dfaSignatureUrl String?
  dfaRemarks      String?
  dfaSignedAt     DateTime?

  daId            String?  // Departmental Administrator
  daName          String?
  daSignatureUrl  String?
  daRemarks       String?
  daSignedAt      DateTime?

  hodId           String?
  hodName         String?
  hodSignatureUrl String?
  hodRemarks      String?
  hodSignedAt     DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routes       RequisitionRoute[]
  comments     RequisitionComment[]
  attachments  RequisitionAttachment[]

  // Payment Voucher raised against this requisition (DFA → Desk Officer → Audit flow)
  paymentVouchers PaymentVoucher[]

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([targetDesignationId])
}

model RequisitionRoute {
  id            String   @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  // Sender
  fromUserId    String
  fromUser      User @relation("RouteFromUser", fields: [fromUserId], references: [id])

  // Recipient — either user or designation (designation routed to all users with that role)
  toUserId       String?
  toUser         User?  @relation("RouteToUser", fields: [toUserId], references: [id])
  toDesignationId String?
  toDesignation  Designation? @relation("RouteToDesignation", fields: [toDesignationId], references: [id])
  toDepartmentId String?

  action       String   // forward | approve | reject | return | close_permanently | submit
  remarks      String?
  acknowledgedAt DateTime?

  // Per-hop signature capture — each user who handles this requisition signs here
  signerName       String?
  signerDesignation String?
  signatureUrl     String?
  signedAt         DateTime?

  createdAt    DateTime @default(now())

  @@index([requisitionId])
  @@index([toUserId])
  @@index([toDesignationId])
}

model RequisitionComment {
  id            String   @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  userId       String
  user         User @relation(fields: [userId], references: [id])
  body         String
  createdAt    DateTime @default(now())

  @@index([requisitionId])
}

model RequisitionAttachment {
  id            String   @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  @@index([requisitionId])
}

// ============================================================
// REGISTRY FILES (physical-file-style routing)
// ============================================================

model RegistryFile {
  id           String   @id @default(cuid())
  fileNumber   String   @unique // e.g. FUTH/REG/IND/2025/0001
  type         String   // individual | department | external | committee
  subject      String
  description  String
  priority     String   @default("Normal")
  volume       String?  // volume number on the registry file cover (GEN.3 REVISED form)

  // Originator
  createdById  String
  createdBy    User     @relation("FileCreator", fields: [createdById], references: [id])

  // Current holder
  currentHolderId String?
  currentHolder   User? @relation("FileCurrentHolder", fields: [currentHolderId], references: [id])

  // Status: Draft -> In Transit -> Received -> Completed -> Archived
  //         | Returned to sender
  status       String   @default("Draft")
  // state: open | in_transit | received | completed | returned | archived
  state        String   @default("open")

  // For individual type
  staffId      String?

  // For department type
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // For external type
  externalName    String?
  externalOrg     String?
  externalEmail   String?
  externalPhone   String?

  // For committee type — link to a Committee record
  committeeId      String?
  committee        Committee? @relation(fields: [committeeId], references: [id])

  // Routing target — either user OR designation
  targetUserId        String?
  targetUser          User? @relation("FileTargetUser", fields: [targetUserId], references: [id])
  targetDesignationId String?
  targetDesignation   Designation? @relation("FileTargetDesignation", fields: [targetDesignationId], references: [id])
  targetDepartmentId  String?

  // Closure signatures — for committee files especially
  cmdSignatureUrl    String?
  cmdSignedAt       DateTime?
  dfaSignatureUrl   String?
  dfaSignedAt       DateTime?
  hodSignatureUrl   String?
  hodSignedAt       DateTime?
  registrySignatureUrl String?
  registrySignedAt      DateTime?

  closedAt     DateTime?
  closedById   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routes       FileRoute[]
  attachments  FileAttachment[]
  comments     FileComment[]

  @@index([status])
  @@index([currentHolderId])
  @@index([targetDesignationId])
  @@index([committeeId])
  @@map("registry_files")
}

// Committee — institutional committee (e.g. Tenders Board, Disciplinary Committee, Promotions Committee)
model Committee {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. TENDERS, DISCIPLINARY, PROMOTIONS, ETHICS, RESEARCH
  name        String
  description String?
  chairpersonId String?  // link to a User
  chairperson  User?     @relation("CommitteeChair", fields: [chairpersonId], references: [id])
  secretaryId  String?
  secretary   User?      @relation("CommitteeSecretary", fields: [secretaryId], references: [id])
  members     String?   // JSON list of member IDs/names (legacy)
  termOfReference String?
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files       RegistryFile[]
  documents   Document[]
  members2    CommitteeMember[]

  @@index([isActive])
  @@map("committees")
}

model CommitteeMember {
  id          String   @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role        String   @default("member")
  addedById   String?
  addedBy     User?    @relation("CommitteeMemberAddedBy", fields: [addedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([committeeId, staffId])
  @@index([committeeId])
  @@index([staffId])
  @@map("committee_members")
}

model PasswordResetRequest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  usernameQuery String
  contactEmail String?
  contactPhone String?
  note        String?
  status      String   @default("pending")
  resolvedById String?
  resolvedBy   User?   @relation("PasswordResetResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model FileRoute {
  id            String   @id @default(cuid())
  fileId        String
  file          RegistryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  fromUserId    String
  fromUser      User @relation("FileRouteFromUser", fields: [fromUserId], references: [id])

  // Recipient — user or designation
  toUserId       String?
  toUser         User? @relation("FileRouteToUser", fields: [toUserId], references: [id])
  toDesignationId String?
  toDesignation  Designation? @relation("FileRouteToDesignation", fields: [toDesignationId], references: [id])
  toDepartmentId String?

  action       String // forward | acknowledge | return | complete | reject | archive
  remarks      String?
  acknowledgedAt DateTime?

  // Per-hop signature capture — each user who handles this file signs here
  signerName       String?
  signerDesignation String?
  signatureUrl     String?
  signedAt         DateTime?

  createdAt    DateTime @default(now())

  @@index([fileId])
  @@index([toUserId])
  @@index([toDesignationId])
  @@map("file_routes")
}

model FileAttachment {
  id            String   @id @default(cuid())
  fileId        String
  file          RegistryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedById  String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([fileId])
  @@map("file_attachments")
}

model FileComment {
  id            String   @id @default(cuid())
  fileId        String
  file          RegistryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId       String
  user         User @relation(fields: [userId], references: [id])
  body         String
  createdAt    DateTime @default(now())

  @@index([fileId])
  @@map("file_comments")
}

// ============================================================
// CMD MAIL — internal messaging for the Chief Medical Director
// ============================================================

model MailMessage {
  id         String   @id @default(cuid())
  subject    String
  body       String

  fromId     String
  from       User     @relation("MailFrom", fields: [fromId], references: [id])

  toId       String
  to         User     @relation("MailTo", fields: [toId], references: [id])

  // Requisition/file link (optional)
  requisitionId String?
  fileId        String?

  // Priority
  priority   String   @default("Normal")

  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  isStarred  Boolean  @default(false)

  readAt     DateTime?
  archivedAt DateTime?

  // Thread support
  parentId   String?
  parent     MailMessage?  @relation("MailThread", fields: [parentId], references: [id])
  replies    MailMessage[] @relation("MailThread")

  createdAt  DateTime @default(now())

  @@index([toId, isRead])
  @@index([fromId])
  @@index([isArchived])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("NotifUser", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  type       String   @default("info") // info | requisition | file | mail | approval
  link       String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("AuditUser", fields: [userId], references: [id])
  action     String
  entity     String?
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// DOCUMENTS — institutional document repository
// Used by Registry to upload hardcopy staff documents, committee files,
// institutional documents, etc. Staff can only upload their own image
// and signature.
// ============================================================

model Document {
  id          String   @id @default(cuid())
  fileNumber  String   @unique // e.g. FUTH/DOC/HDC/2026/0001 — auto-generated per category per year
  title       String
  description String?

  // Category drives permission + display grouping.
  // staff_hardcopy   : scanned hardcopy of a staff record (NIN card, certificate, etc.) — managers only
  // committee_file   : document attached to a committee (minutes, agenda, decisions)
  // institutional   : institutional policy / memo / directive
  // personal_image  : staff member's own passport photo (linked to staff.avatarUrl)
  // personal_signature : staff member's own signature image (linked to staff.signatureUrl)
  // other           : misc
  category    String

  // File metadata (stored via /api/uploads)
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?

  // Optional links (filled based on category)
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])

  // Optional metadata for hardcopies
  documentDate DateTime?  // date the original document was issued (for scanned hardcopies)
  tags         String?    // comma-separated tags

  // Visibility — true = visible to all logged-in users; false = only uploader + managers can see
  isPublic     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId])
  @@index([committeeId])
  @@index([category])
  @@index([uploadedById])
  @@index([isPublic])
  @@index([fileNumber])
  @@map("documents")
}
