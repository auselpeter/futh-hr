  handoverCompleted      Boolean @default(false)
  assetsReturned         Boolean @default(false)
  clearanceFormUrl       String?

  // Final entitlements
  finalSalary       Float?
  gratuityAmount    Float?
  pensionBalance    Float?
  leaveEncashment   Float?

  // Status: Draft | Submitted | HOD Approved | DFA Approved | CMD Approved | Rejected | Cancelled | Completed
  status          String   @default("Submitted")
  state           String   @default("open")

  // Approval signatures
  hodId           String?
  hodName         String?
  hodSignatureUrl String?
  hodRemarks      String?
  hodSignedAt     DateTime?

  dfaId           String?
  dfaName         String?
  dfaSignatureUrl String?
  dfaRemarks      String?
  dfaSignedAt     DateTime?

  cmdId           String?
  cmdName         String?
  cmdSignatureUrl String?
  cmdRemarks      String?
  cmdSignedAt     DateTime?

  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId])
  @@index([status])
}

model Resignation {
  id             String   @id @default(cuid())
  refNumber      String   @unique // e.g. RSG-2026-000001
  staffId        String
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  reason         String
  detailedReason String?
  resignationDate DateTime // date the letter was submitted
  noticeDate     DateTime? // date notice was given
  effectiveDate  DateTime // last working day
  lastWorkingDate DateTime?

  // Withdrawal
  isWithdrawn    Boolean @default(false)
  withdrawnAt    DateTime?
  withdrawnById  String?

  // Exit interview
  exitInterviewConducted Boolean @default(false)
  exitInterviewNotes String?
  handoverCompleted      Boolean @default(false)
  assetsReturned        Boolean @default(false)
  clearanceFormUrl      String?

  // Final entitlements
  finalSalary       Float?
  gratuityAmount    Float?
  pensionBalance    Float?
  leaveEncashment   Float?

  // Status: Draft | Submitted | HOD Acknowledged | DFA Approved | CMD Approved | Accepted | Rejected | Withdrawn | Completed
  status          String   @default("Submitted")
  state           String   @default("open")

  // Approval signatures
  hodId           String?
  hodName         String?
  hodSignatureUrl String?
  hodRemarks      String?
  hodSignedAt     DateTime?

  dfaId           String?
  dfaName         String?
  dfaSignatureUrl String?
  dfaRemarks      String?
  dfaSignedAt     DateTime?

  cmdId           String?
  cmdName         String?
  cmdSignatureUrl String?
  cmdRemarks      String?
  cmdSignedAt     DateTime?

  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([staffId])
  @@index([status])
}

// ============================================================
